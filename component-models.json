            "name": "Center",
            "value": "center"
          },
          {
            "name": "Blue1 Background",
            "value": "blue1-background"
          },
          {
            "name": "Blue2 Background",
            "value": "blue2-background"
          },
          {
            "name": "Blue3 Background",
            "value": "blue3-background"
          }
        ]
      }
    ]
  },
  {
    "id": "brightcove",
    "fields": [
      {
        "component": "text",
        "valueType": "string",
        "name": "div:nth-child(1)>div:nth-child(2)>p:nth-child(1)",
        "label": "Account ID",
        "description": "Brightcove account ID (default in place but can be changed)",
        "required": true
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "div:nth-child(2)>div:nth-child(2)>p:nth-child(1)",
        "label": "Video ID",
        "description": "Brightcove video ID (If you have a REF ID, 'ref:' is part of the actual Id!)",
        "required": true
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "div:nth-child(3)>div:nth-child(2)",
        "label": "Playlist ID",
        "description": "Optional playlist ID (If you have a REF ID, 'ref:' is part of the actual Id!)"
      },
      {
        "component": "select",
        "valueType": "string",
        "name": "div:nth-child(4)>div:nth-child(2)>p:nth-child(1)",
        "label": "Playlist Location",
        "options": [
          {
            "name": "Right sidekick",
            "value": "R"
          },
          {
            "name": "Bottom",
            "value": "B"
          },
          {
            "name": "Hidden (no captions or aspect ratio options)",
            "value": "H"
          }
        ],
        "description": "Location of the playlist (R=right, B=bottom, H=hidden)"
      },
      {
        "component": "select",
        "valueType": "string",
        "name": "div:nth-child(5)>div:nth-child(2)>p:nth-child(1)",
        "label": "Aspect Ratio",
