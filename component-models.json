          {
            "name": "16:9",
            "value": "16:9"
          },
          {
            "name": "4:3",
            "value": "4:3"
          }
        ],
        "description": "Video aspect ratio (Note: Hidden playlist has no aspect ratio options)"
      },
      {
        "component": "select",
